# QQ Bat 高代码模式环境变量示例
# 复制为 .env 并按需修改

ENVIRONMENT=prod
DRIVER=~fastapi+~websockets

# ── 适配器开关（核心）──────────────────────────────────────
# 逗号分隔，按顺序加载并注册对应平台适配器。
# 不配置则默认 OneBot V11（保持向后兼容，QQ 通过 NapCat/go-cqhttp 等协议端接入）。
# 启用其他平台前需先 pip install 对应适配器，详见 pyproject.toml 的 [project.optional-dependencies]。
# bot.py 会根据此配置动态注册（详见 _ADAPTER_MAP）。
BOT_ADAPTERS=OneBot V11
# 同时跑 QQ + 飞书 + KOOK 示例（需先 pip install -e ".[cn]"）：
# BOT_ADAPTERS=OneBot V11,Feishu,Kook

# ── OneBot V11（QQ，通过 NapCat/go-cqhttp 等协议端）──
# 由 QQ Bat 创建项目时自动写入；如手动修改，确保与 NapCat WebSocket 地址一致
ONEBOT_WS_URLS=["ws://127.0.0.1:{{NAPCAT_PORT}}/onebot/v11/ws"]
# ONEBOT_ACCESS_TOKEN=

# ── 飞书（Feishu，企业自建应用）──
# 1. pip install nonebot-adapter-feishu（或 pip install -e ".[feishu]"）
# 2. 在飞书开放平台创建企业自建应用，获取 AppID/AppSecret
# 3. 启用事件订阅，长连接模式无需配置回调地址
# 4. 取消下行注释 + 在 BOT_ADAPTERS 加 Feishu
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

# ── KOOK（开黑啦，国内游戏社区）──
# 1. pip install nonebot-adapter-kook（或 pip install -e ".[kook]"）
# 2. 在 KOOK 开发者中心创建机器人，获取 Bot Token
# 3. 取消下行注释 + 在 BOT_ADAPTERS 加 Kook
# KOOK_BOT_TOKEN=
# KOOK_VERIFY_TOKEN=

# ── QQ 频道（已废弃，建议改用官方 API 适配器）──
# pip install nonebot-adapter-qqguild
# QQGUILD_APP_ID=
# QQGUILD_APP_SECRET=
# QQGUILD_TOKEN=

# ── Telegram（国外）──
# pip install nonebot-adapter-telegram
# TELEGRAM_BOT_TOKEN=

# ── Discord（国外）──
# pip install nonebot-adapter-discord
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=

# ── Satori（统一协议，可同时接入 QQ/QQ频道/Telegram/微信等多平台）──
# pip install nonebot-adapter-satori
# SATORI_HOST=
# SATORI_PORT=
# SATORI_TOKEN=
