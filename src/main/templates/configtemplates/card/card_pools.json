{
  "tableName": "card_pools",
  "displayName": "卡池配置表",
  "fields": [
    {
      "name": "id",
      "label": "编号",
      "type": "integer",
      "description": "卡池编号",
      "notNull": true
    },
    {
      "name": "name",
      "label": "卡池名称",
      "type": "text",
      "description": "卡池中文名称",
      "notNull": true
    },
    {
      "name": "pool_type",
      "label": "卡池类型",
      "type": "enum",
      "enumValues": [
        "常驻",
        "限定",
        "新手",
        "活动"
      ],
      "description": "卡池类型（常驻/限定/新手/活动）",
      "notNull": true
    },
    {
      "name": "cost_currency",
      "label": "抽卡货币",
      "type": "enum",
      "enumValues": [
        "钻",
        "金币",
        "友情点",
        "活动票"
      ],
      "description": "抽卡消耗的货币类型（钻=高级货币/金币=基础货币/友情点=友情池专用/活动票=活动池专用）",
      "notNull": true
    },
    {
      "name": "cost_per_draw",
      "label": "单抽消耗",
      "type": "integer",
      "description": "单次抽卡消耗数量",
      "notNull": true
    },
    {
      "name": "ten_draw_discount",
      "label": "十连消耗",
      "type": "integer",
      "description": "十连抽卡消耗数量（通常为单抽×9或×10）",
      "notNull": true
    },
    {
      "name": "pity_threshold",
      "label": "保底次数",
      "type": "integer",
      "description": "触发保底所需的抽卡次数",
      "notNull": true
    },
    {
      "name": "pity_guarantee_rarity",
      "label": "保底稀有度",
      "type": "enum",
      "enumValues": [
        "N",
        "R",
        "SR",
        "SSR",
        "UR"
      ],
      "description": "保底获得的卡牌稀有度（与 cards.rarity/rarity_config.rarity 一致）",
      "notNull": true
    },
    {
      "name": "daily_limit",
      "label": "每日上限",
      "type": "integer",
      "description": "每日抽卡次数上限（0=无限制）",
      "notNull": true
    },
    {
      "name": "description",
      "label": "描述",
      "type": "text",
      "description": "卡池配置说明"
    }
  ],
