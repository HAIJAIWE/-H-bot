{
  "tableName": "draw_rates",
  "displayName": "抽卡概率表",
  "fields": [
    {
      "name": "id",
      "label": "编号",
      "type": "integer",
      "description": "概率配置编号",
      "notNull": true
    },
    {
      "name": "pool_id",
      "label": "卡池编号",
      "type": "integer",
      "description": "关联卡池编号（对应 card_pools.id）",
      "notNull": true
    },
    {
      "name": "rarity",
      "label": "稀有度",
      "type": "enum",
      "enumValues": [
        "N",
        "R",
        "SR",
        "SSR",
        "UR"
      ],
      "description": "稀有度标识",
      "notNull": true
    },
    {
      "name": "base_rate",
      "label": "基础概率",
      "type": "real",
      "description": "该稀有度的基础掉落概率（0.0~1.0）",
      "notNull": true
    },
    {
      "name": "pity_rate",
      "label": "保底增量",
      "type": "real",
      "description": "每抽未出该稀有度时概率增加量（0=无递增）",
      "notNull": true
    },
    {
      "name": "max_pity_count",
      "label": "保底阈值",
      "type": "integer",
      "description": "触发硬保底的抽卡次数（0=无硬保底）",
      "notNull": true
    },
    {
      "name": "guarantee_count",
      "label": "软保底起始",
      "type": "integer",
      "description": "软保底开始的抽卡次数（0=无软保底）",
      "notNull": true
    },
    {
      "name": "description",
      "label": "描述",
      "type": "text",
      "description": "抽卡概率说明"
    }
  ],
