{
  "tableName": "fragments",
  "displayName": "碎片合成表",
  "fields": [
    {
      "name": "id",
      "label": "编号",
      "type": "integer",
      "description": "碎片配置编号",
      "notNull": true
    },
    {
      "name": "card_id",
      "label": "目标卡牌",
      "type": "integer",
      "description": "合成目标卡牌编号（对应 cards.id）",
      "notNull": true
    },
    {
      "name": "fragment_name",
      "label": "碎片名称",
      "type": "text",
      "description": "碎片中文名称",
      "notNull": true
    },
    {
      "name": "fragments_needed",
      "label": "所需碎片数",
      "type": "integer",
      "description": "合成所需碎片数量",
      "notNull": true
    },
    {
      "name": "fragment_source",
      "label": "碎片来源",
      "type": "enum",
      "enumValues": [
        "商店",
        "活动",
        "副本",
        "分解",
        "签到"
      ],
      "description": "碎片主要获取途径",
      "notNull": true
    },
    {
      "name": "fragment_price",
      "label": "单价",
      "type": "integer",
      "description": "商店购买单价（0=不可购买）",
      "notNull": true
    },
    {
      "name": "description",
      "label": "描述",
      "type": "text",
      "description": "碎片合成说明"
    }
  ],
