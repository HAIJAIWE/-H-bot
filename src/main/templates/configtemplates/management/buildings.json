{
  "tableName": "buildings",
  "displayName": "建筑配置表",
  "fields": [
    {
      "name": "id",
      "label": "编号",
      "type": "integer",
      "description": "建筑编号",
      "notNull": true
    },
    {
      "name": "name",
      "label": "建筑名称",
      "type": "text",
      "description": "建筑中文名称",
      "notNull": true
    },
    {
      "name": "type",
      "label": "建筑类型",
      "type": "enum",
      "enumValues": [
        "生产",
        "住宅",
        "装饰",
        "功能",
        "防御"
      ],
      "description": "建筑类型（生产/住宅/装饰/功能/防御）",
      "notNull": true
    },
    {
      "name": "level_max",
      "label": "最大等级",
      "type": "integer",
      "description": "建筑可升级到的最大等级",
      "notNull": true
    },
    {
      "name": "base_cost",
      "label": "基础造价",
      "type": "integer",
      "description": "1级建造所需金币",
      "notNull": true
    },
    {
      "name": "cost_multiplier",
      "label": "升级成本倍率",
      "type": "real",
      "description": "每级升级成本相对上一级的倍率（如1.5=每级增加50%）",
      "notNull": true
    },
    {
      "name": "build_time",
      "label": "建造时间",
      "type": "integer",
      "description": "1级建造所需秒数",
      "notNull": true
    },
    {
      "name": "unlock_level",
      "label": "解锁等级",
      "type": "integer",
      "description": "玩家声望达到该等级时解锁",
      "notNull": true
    },
    {
      "name": "description",
      "label": "描述",
      "type": "text",
      "description": "建筑配置说明"
    }
  ],
