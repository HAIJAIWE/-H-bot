{
  "tableName": "workers",
  "displayName": "员工配置表",
  "fields": [
    {
      "name": "id",
      "label": "编号",
      "type": "integer",
      "description": "员工编号",
      "notNull": true
    },
    {
      "name": "name",
      "label": "员工名称",
      "type": "text",
      "description": "员工中文名称",
      "notNull": true
    },
    {
      "name": "role",
      "label": "职业",
      "type": "enum",
      "enumValues": [
        "农夫",
        "矿工",
        "木匠",
        "商人",
        "法师",
        "守卫",
        "学者"
      ],
      "description": "员工职业类型",
      "notNull": true
    },
    {
      "name": "hire_cost",
      "label": "雇佣费用",
      "type": "integer",
      "description": "雇佣所需金币",
      "notNull": true
    },
    {
      "name": "salary",
      "label": "每小时工资",
      "type": "integer",
      "description": "每小时消耗金币（0=无工资）",
      "notNull": true
    },
    {
      "name": "efficiency",
      "label": "效率倍率",
      "type": "real",
      "description": "对建筑产出的效率倍率（1.0=100%）",
      "notNull": true
    },
    {
      "name": "food_consumption",
      "label": "食物消耗",
      "type": "integer",
      "description": "每小时消耗食物数量",
      "notNull": true
    },
    {
      "name": "unlock_level",
      "label": "解锁等级",
      "type": "integer",
      "description": "玩家声望达到该等级时解锁",
      "notNull": true
    },
    {
      "name": "description",
      "label": "描述",
      "type": "text",
      "description": "员工配置说明"
    }
  ],
