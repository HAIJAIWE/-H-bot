{
  "tableName": "market",
  "displayName": "市场配置表",
  "fields": [
    {
      "name": "id",
      "label": "编号",
      "type": "integer",
      "description": "商品编号",
      "notNull": true
    },
    {
      "name": "item_name",
      "label": "商品名称",
      "type": "text",
      "description": "商品中文名称",
      "notNull": true
    },
    {
      "name": "item_type",
      "label": "商品类型",
      "type": "enum",
      "enumValues": [
        "资源",
        "道具",
        "装备",
        "碎片",
        "礼包"
      ],
      "description": "商品类型",
      "notNull": true
    },
    {
      "name": "buy_price",
      "label": "购买单价",
      "type": "integer",
      "description": "购买所需金币（0=不可购买）",
      "notNull": true
    },
    {
      "name": "sell_price",
      "label": "出售单价",
      "type": "integer",
      "description": "出售获得金币（0=不可出售）",
      "notNull": true
    },
    {
      "name": "stock",
      "label": "库存",
      "type": "integer",
      "description": "当前库存（-1=无限）",
      "notNull": true
    },
    {
      "name": "refresh_interval",
      "label": "刷新间隔",
      "type": "integer",
      "description": "库存刷新间隔秒数（0=不刷新）",
      "notNull": true
    },
    {
      "name": "demand",
      "label": "需求度",
      "type": "enum",
      "enumValues": [
        "低",
        "中",
        "高",
        "极高"
      ],
      "description": "市场需求度（影响价格波动）",
      "notNull": true
    },
    {
      "name": "description",
      "label": "描述",
      "type": "text",
      "description": "市场商品说明"
    }
  ],
