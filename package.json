{
  "name": "qqbat",
  "version": "0.1.0",
  "description": "AI 驱动的可视化 QQ 机器人开发框架",
  "main": "./out/main/index.js",
  "author": "H Bot 制造",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "keywords": [
    "qq-bot",
    "electron",
    "react",
    "node-editor",
    "visual-programming",
    "ai-agent",
    "low-code",
    "chatbot",
    "game-bot"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "node scripts/ensure-sqlite.js electron && electron-vite dev",
    "dev:win": "node scripts/ensure-sqlite.js electron && chcp 65001 >NUL && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "node scripts/ensure-sqlite.js node && vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "node scripts/ensure-sqlite.js electron",
    "rebuild:node": "node scripts/ensure-sqlite.js node",
    "pack": "node scripts/ensure-sqlite.js electron && electron-vite build && electron-builder --win --config electron-builder.yml",
    "audit": "node scripts/audit.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "docs:api": "typedoc",
    "docs:api:watch": "typedoc --watch",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:identity": "node scripts/check-identity-conflicts.mjs",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:userdata": "node scripts/check-userdata-layout.mjs",
    "check:i18n": "node scripts/i18n-extract-copy.mjs && node scripts/i18n-build-catalog.mjs --check",
    "clean:cache": "node scripts/clean-cache.js",
    "docs:nodes": "node scripts/gen-nodes-reference.mjs",
    "docs:nodes:check": "node scripts/gen-nodes-reference.mjs --check",
    "audit:baseline": "node scripts/audit-baseline.mjs",
    "audit:baseline:check": "node scripts/audit-baseline.mjs --check"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^42.8.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^24.1.0",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/electron": "^7.18.0",
    "@types/react-window": "^1.8.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.4.4",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.22.0",
    "node-pty": "^1.1.0",
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-window": "^1.8.11",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.1",
    "zustand": "^5.0.14"
  }
}
