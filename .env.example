# H Bot 制造（qqbat）环境变量模板
# ---------------------------------------------------------------------------
# 复制本文件为 `.env` 后填入本机值即可。`.env` 已被 .gitignore 忽略，不会入库。
#
# 本仓库的 `.env` 由 src/main/runtime/headlessAssembly.ts 的 loadDotEnvFile 读取，
# 读取的是【项目目录】下的 `.env`（每个项目一份），不是仓库根。
# 本地起开发 / 无头模式时，把它放进你的项目目录，或直接 export 到 shell 环境。
#
# ⚠️ 关于“密钥 / 凭据”：
#   - QQ 官方协议端的 AppID / AppSecret、以及 AI 模型提供方的 apiKey，
#     都只配置在【应用内设置】里（落盘到项目目录的 .qqbat/，且用 safeStorage 加密），
#     既不在 .env，也不进仓库。这里【不要】放任何真实密钥。
#   - 下面这些变量多为开发端口 / 开关 / 目录，不是机密；按需开启。
# ---------------------------------------------------------------------------

# —— 开发 / 调试端口 ——
QQBAT_CDP_PORT=9222                 # Electron 远程调试（Chrome DevTools Protocol）端口
QQBAT_MCP_SSE_PORT=4000             # 内置 MCP SSE 服务端口
QQBOT_BUS_PORT=18765                # 主进程 ↔ 渲染 / 无头总线端口
QQBOT_BUS_HOST=127.0.0.1            # 总线监听地址（默认本机回环）

# —— 无头 / 独立运行模式 ——
QQBOT_PROJECT_ROOT=                # 指定要加载的项目目录（standalone 模式）
QQBAT_STANDALONE_DIR=              # 无头运行的工作目录
QQBAT_USER_DATA_DIR=              # 覆盖用户数据目录（默认 <USERPROFILE>/AppData/Roaming/qqbat）
QQBAT_ALLOW_MULTI_INSTANCE=0       # 1 = 允许同时起多个实例
QQ_SANDBOX=                        # 沙箱相关开关（按运行环境填写）

# —— 内置 MCP 目标（仅当启用 MCP 时填写）——
QQBAT_MCP_PROJECT=                 # 单个 MCP 目标项目路径
QQBAT_MCP_PROJECTS=                # 多个 MCP 目标项目路径（逗号分隔）

# —— AI 相关开关 ——
QQBAT_KB=1                         # 知识包（knowledge packs）开关，0 = 关闭
QQBAT_AI_ALLOW_DESTRUCTIVE=0       # 1 = 允许 AI 执行破坏性操作（默认关）
QQBAT_AI_ALLOWED_TARGETS=          # AI 允许操作的目标白名单（逗号分隔；留空=默认）

# —— 运行时 / 监控 ——
QQBAT_NODE_CALL_TIMEOUT_MS=        # 节点调用超时（毫秒）
LOG_LEVEL=info                     # 日志级别：debug / info / warn / error
NODE_ENV=development               # development / production
SENTRY_DSN=                        # 错误监控 DSN（留空=不上报；非机密，但建议各环境自行填）
SUPER_ADMIN_IDS=                   # 超级管理员标识列表（逗号分隔；按平台填写）
